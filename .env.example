# Copy to .env.local and fill in to enable live eligibility checks.
# Without STEDI_API_KEY the app runs in demo mode (mock data, no PHI leaves the server).

# Clearinghouse API key — create one at https://www.stedi.com (test mode available)
STEDI_API_KEY=

# Payer ID (tradingPartnerServiceId) to route 270 requests to.
# In production this comes from the patient's insurance card / payer directory.
STEDI_PAYER_ID=

# Override if Stedi versions the endpoint — confirm against
# https://www.stedi.com/docs/healthcare/api-reference/post-healthcare-eligibility
# STEDI_ELIGIBILITY_URL=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/eligibility/v3

# Rendering provider identity, required on every 270 request.
# 1999999984 is a standard test NPI — replace with the practice's real NPI.
PROVIDER_NPI=1999999984
PROVIDER_ORGANIZATION_NAME=Demo Endodontics
